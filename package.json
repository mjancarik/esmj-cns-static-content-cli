{
	"name": "@esmj/cns-static-content-cli",
	"version": "0.2.3",
	"description": "Build Parcel static-content projects and export HTML, CSS, and JavaScript artifacts.",
	"type": "module",
	"bin": {
		"esmj-cns-static-content-cli": "src/cli.mjs"
	},
	"exports": {
		".": "./src/build.mjs",
		"./mock": "./src/mock.mjs",
		"./lint": "./src/lint.mjs",
		"./verify": "./src/verify.mjs",
		"./biome.json": "./src/biome-preset.json"
	},
	"files": [
		"src/",
		"agent/",
		"vendor/"
	],
	"bundleDependencies": [
		"parcel-resolver-cns-exports"
	],
	"scripts": {
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"test": "node --test test/*.test.mjs"
	},
	"engines": {
		"node": ">=24"
	},
	"author": "Miroslav Jancarik",
	"license": "MIT",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	},
	"dependencies": {
		"@biomejs/biome": "2.6.7",
		"@esmj/size": "^0.9.1",
		"@parcel/config-default": "^2.16.4",
		"@parcel/core": "^2.16.4",
		"@parcel/node-resolver-core": "^3.7.4",
		"@parcel/plugin": "^2.16.4",
		"@parcel/reporter-cli": "^2.16.4",
		"@parcel/utils": "^2.16.4",
		"clipboardy": "^3.0.0",
		"cssbeautify": "^0.3.1",
		"es-check": "^6.2.1",
		"identity-obj-proxy": "^3.0.0",
		"jest": "^30.0.0",
		"jest-environment-jsdom": "^30.0.0",
		"jsdom": "^19.0.0",
		"parcel": "^2.16.4",
		"parcel-resolver-cns-exports": "file:vendor/parcel-resolver-cns-exports",
		"pixelmatch": "^8.0.0",
		"playwright": "1.65.0",
		"pngjs": "^7.0.0",
		"pretty": "^2.0.0",
		"purgecss": "^4.1.3"
	}
}
