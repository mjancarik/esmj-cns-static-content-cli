{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/dist", "!**/.parcel-cache", "!**/node_modules"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "bracketSameLine": false
    },
    "globals": [
      "describe", "fdescribe", "xdescribe", "it", "fit", "xit",
      "test", "xtest", "expect", "expectAsync", "beforeEach", "afterEach",
      "beforeAll", "afterAll", "jasmine", "jest", "spyOn", "spyOnProperty",
      "spyOnAllFunctions", "fail", "pending", "setSpecProperty", "setSuiteProperty"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUndeclaredVariables": "error"
      },
      "suspicious": {
        "noConsole": {
          "level": "error",
          "options": { "allow": ["log", "warn", "error"] }
        }
      }
    }
  }
}